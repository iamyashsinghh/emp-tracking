# ---- Shared ----
NODE_ENV=development

# ---- Postgres ----
POSTGRES_USER=emptrack
POSTGRES_PASSWORD=emptrack
POSTGRES_DB=emptrack
DATABASE_URL=postgresql://emptrack:emptrack@localhost:5432/emptrack?schema=public

# ---- Backend ----
BACKEND_PORT=4000
# Use a long random string in production
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
# Comma separated list of allowed dashboard origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Object storage (S3 compatible, MinIO by default) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=emptrack-media
# Public base used in generated URLs (MinIO console/proxy)
S3_PUBLIC_URL=http://localhost:9000

# ---- Dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Docker compose (optional overrides) ----
# Run the demo seed when the `migrate` service runs: SEED=true docker compose up migrate
SEED=false
# Endpoint the backend container uses to reach MinIO inside the compose network
S3_INTERNAL_ENDPOINT=http://minio:9000
# Host ports
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DASHBOARD_PORT=3000

# ---- Deploy (set on the server's .env; the Deploy workflow fills these in) ----
# BACKEND_IMAGE=ghcr.io/<owner>/emp-tracking-backend:sha-xxxxxxxxxxxx
# BACKEND_MIGRATE_IMAGE=ghcr.io/<owner>/emp-tracking-backend-migrate:sha-xxxxxxxxxxxx
# DASHBOARD_IMAGE=ghcr.io/<owner>/emp-tracking-dashboard:sha-xxxxxxxxxxxx
