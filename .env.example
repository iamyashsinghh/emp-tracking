# ---- Shared ----
NODE_ENV=development

# ---- Postgres ----
POSTGRES_USER=emptrack
POSTGRES_PASSWORD=emptrack
POSTGRES_DB=emptrack
DATABASE_URL=postgresql://emptrack:emptrack@localhost:5432/emptrack?schema=public

# ---- Backend ----
BACKEND_PORT=4002
# Use a long random string in production
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
# Comma separated list of allowed dashboard origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Media storage (screenshots / recordings) ----
# local (default): files are written to STORAGE_DIR, one subfolder per tenant,
# and served by the backend through short-lived signed links.
# s3: use the S3/MinIO settings below instead.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Externally reachable backend URL. Agents upload to and the dashboard loads
# media from signed links on this host, so in production set it to the public
# URL behind your reverse proxy (e.g. https://api.example.com).
PUBLIC_API_URL=http://localhost:4002

# ---- Object storage (only when STORAGE_DRIVER=s3) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=emptrack-media
# Externally reachable S3/MinIO URL. Presigned upload/download URLs are signed
# against this host, so desktop agents must be able to reach it. In production
# set it to the public MinIO URL behind your reverse proxy (e.g. https://s3.example.com),
# never the internal http://minio:9000.
S3_PUBLIC_URL=http://localhost:9000

# ---- Dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:4002

# ---- Docker compose (optional overrides) ----
# `localdb` starts the bundled Postgres container. To use a Postgres already
# running on the host instead, remove `localdb` (COMPOSE_PROFILES=) and set:
# DOCKER_DATABASE_URL=postgresql://emptrack:secret@host.docker.internal:5432/emptrack?schema=public
COMPOSE_PROFILES=localdb
# Run the demo seed when the `migrate` service runs: SEED=true docker compose up migrate
SEED=false
# Endpoint the backend container uses to reach MinIO inside the compose network
# (STORAGE_DRIVER=s3 only; start MinIO with `docker compose --profile s3 up -d`)
S3_INTERNAL_ENDPOINT=http://minio:9000
# MinIO server image (upstream minio/minio is no longer published on Docker Hub)
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# Host ports
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DASHBOARD_PORT=3000

# ---- Deploy (set on the server's .env; the Deploy workflow fills these in) ----
# BACKEND_IMAGE=ghcr.io/<owner>/emp-tracking-backend:sha-xxxxxxxxxxxx
# BACKEND_MIGRATE_IMAGE=ghcr.io/<owner>/emp-tracking-backend-migrate:sha-xxxxxxxxxxxx
# DASHBOARD_IMAGE=ghcr.io/<owner>/emp-tracking-dashboard:sha-xxxxxxxxxxxx
