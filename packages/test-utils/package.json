{
  "name": "@emptrack/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test fixtures, factories, DB helpers and mocks for every workspace",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./mocks/*": "./src/mocks/*.ts",
    "./vitest": "./vitest.shared.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emptrack/shared": "*",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
