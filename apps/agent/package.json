{
  "name": "@emptrack/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform employee monitoring desktop agent (Windows, macOS, Linux)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:staging": "npm run build && node scripts/copy-assets.js --server-url=https://employee.staging.ashniva.com && electron-builder"
  },
  "dependencies": {
    "@emptrack/shared": "*",
    "active-win": "^8.2.1",
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "@emptrack/test-utils": "*"
  },
  "build": {
    "appId": "com.emptrack.agent",
    "productName": "EmpTrack Agent",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
